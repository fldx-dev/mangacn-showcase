# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Series artwork (copyright Eiichiro Oda / Shueisha, Toei Animation) is not part of this
# repository. The site renders typeset stand-ins without it; the deployed demo adds the files.
/public/posters/*
/public/forms/*
/public/story/*
!/public/posters/.gitkeep
!/public/forms/.gitkeep
!/public/story/.gitkeep

# QA screenshots and reports
/.shots/
